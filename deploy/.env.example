# Hermes OKE — Environment Variables
# Copy to .env and fill in values

# Hermes API Server (for OKE frontend chat)
HERMES_API_KEY=change-me-strong-key

# OKE Backend API
OKE_API_URL=http://localhost:8000
OKE_API_KEY=
OKE_TENANT_ID=
OKE_COMPANY_ID=

# LLM Providers (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram Gateway (optional)
TELEGRAM_BOT_TOKEN=
